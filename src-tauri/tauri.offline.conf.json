{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris-Offline",
  "app": {
    "security": {
      "capabilities": ["default", "offline"]
    }
  },
  "bundle": {
    "externalBin": ["binaries/ollama"],
    "targets": ["nsis", "appimage"],
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    },
    "resources": {
      "../dist": "dist",
      "../bundled-model": "bundled-model",
      "ollama-lib": "lib"
    }
  }
}
