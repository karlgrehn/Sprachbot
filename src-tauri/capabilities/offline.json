{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "offline",
  "description": "Nur für die Offline-Variante: erlaubt, den gebündelten Ollama-Sidecar zu starten (siehe tauri.offline.conf.json).",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ollama",
          "sidecar": true,
          "args": ["serve"]
        }
      ]
    }
  ]
}
